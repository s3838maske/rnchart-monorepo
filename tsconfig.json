{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@rnchart/core": ["packages/core/src/index.ts"],
      "@rnchart/core/*": ["packages/core/src/*"],
      "@rnchart/skia": ["packages/skia/src/index.ts"],
      "@rnchart/skia/*": ["packages/skia/src/*"],
      "@rnchart/charts": ["packages/charts/src/index.ts"],
      "@rnchart/charts/*": ["packages/charts/src/*"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "example/**/*.ts",
    "example/**/*.tsx"
  ],
  "exclude": ["**/node_modules/**", "**/lib/**", "**/.expo/**"]
}
