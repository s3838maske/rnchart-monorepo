{
  "name": "react-native-graphify",
  "version": "0.4.0",
  "description": "Skia-powered charts for React Native. 15+ chart types with a UI-thread touch cursor, pan/zoom, streaming, drilldown, statistical series and a real screen-reader layer. No WebView, one API for iOS and Android.",
  "keywords": [
    "react-native",
    "chart",
    "charts",
    "graph",
    "skia",
    "react-native-skia",
    "data-visualization",
    "visualization",
    "line-chart",
    "bar-chart",
    "area-chart",
    "pie-chart",
    "donut-chart",
    "scatter-plot",
    "tooltip",
    "reanimated",
    "ios",
    "android",
    "expo",
    "typescript",
    "radar-chart",
    "gauge",
    "polar-chart",
    "wind-rose",
    "box-plot",
    "histogram",
    "waterfall",
    "streaming",
    "accessibility",
    "drilldown"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s3838maske/rnchart-monorepo.git"
  },
  "homepage": "https://github.com/s3838maske/rnchart-monorepo#readme",
  "bugs": {
    "url": "https://github.com/s3838maske/rnchart-monorepo/issues"
  },
  "license": "MIT",
  "author": "shubham-maske",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/.*"
  ],
  "sideEffects": false,
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "example"
  ],
  "scripts": {
    "build": "bob build",
    "prepare": "bob build",
    "clean": "del-cli lib",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "node bench/index.mjs",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "docs:api": "typedoc",
    "example": "yarn workspace rnchart-example run start",
    "example:ios": "yarn workspace rnchart-example run ios",
    "example:android": "yarn workspace rnchart-example run android",
    "verify": "yarn lint && yarn typecheck && yarn test && yarn build",
    "preversion": "yarn verify",
    "prepublish:check": "node scripts/prepublish-check.mjs"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-quadtree": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-time": "^3.1.0"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.0.0",
    "expo-haptics": ">=13.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.78.0",
    "react-native-gesture-handler": ">=2.16.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-worklets": ">=0.7.0"
  },
  "peerDependenciesMeta": {
    "expo-haptics": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@shopify/react-native-skia": "2.6.2",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-quadtree": "^3.0.6",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-time": "^3.0.4",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.18",
    "babel-jest": "^29.7.0",
    "del-cli": "^7.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "expo-haptics": "~57.0.1",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.43.0",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "size-limit": "^13.0.3",
    "tinybench": "^6.1.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ],
    "exclude": "**/{__tests__/**,__fixtures__/**,__mocks__/**,*.test.*}"
  }
}
